API_KEY="YOUR_GEMINI_API_KEY"

# ---- Google Maps (client-side; restrict by HTTP referrer in GCP) ----
VITE_GOOGLE_MAPS_API_KEY="YOUR_GOOGLE_MAPS_API_KEY"
