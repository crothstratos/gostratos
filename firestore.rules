rules_version = '2';

// Stratos VP CRM — Firestore access policy
//
// Access requires a signed-in Google account with a verified
// @gostratos.vc email address that is not on the revoked list.
//
// To grant an outside collaborator access, add their address to the
// EXTRA list in allowed(). To revoke someone, add them to revoked().
// Redeploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function revoked() {
      return userEmail() in [
        'dwhite@gostratos.vc',
        'cjrothai@gmail.com',
        'joe@highwayventures.com'
      ];
    }

    function allowed() {
      return userEmail().matches('^[^@]+@gostratos[.]vc$')
        || userEmail() in [
          // Individually approved outside collaborators go here, e.g.:
          // 'advisor@example.com',
          'placeholder@example.invalid'
        ];
    }

    function hasAccess() {
      return signedIn() && allowed() && !revoked();
    }

    // IMPORTANT: Firestore combines matching allow rules with OR. A broad
    // `match /{document=**} { allow write }` therefore GRANTS write to every
    // collection, and no narrower rule can take it back — an earlier version
    // of this file tried to make /audit append-only underneath such a
    // catch-all, and the restriction did nothing at all.
    //
    // So collections are listed explicitly and there is no catch-all. If a
    // new collection is added to the app, add it here too, or the app will
    // fail with "Missing or insufficient permissions" on that collection.
    //
    // Collections in use: attachments, audit, companies, company_data_pool,
    // contacts, events, investor_repository, investors, sourcing.

    match /companies/{id} {
      allow read, write: if hasAccess();
    }

    match /investors/{id} {
      allow read, write: if hasAccess();
    }

    match /investor_repository/{id} {
      allow read, write: if hasAccess();
    }

    match /events/{id} {
      allow read, write: if hasAccess();
    }

    match /attachments/{id} {
      allow read, write: if hasAccess();
    }

    match /company_data_pool/{id} {
      allow read, write: if hasAccess();
    }

    // The contacts directory. Bulk-loaded by scripts/import-contacts.cjs
    // through the Admin SDK, which bypasses these rules, and added to one at a
    // time from the app's quick-add.
    //
    // Delete stays closed. A contact id is referenced from every company that
    // person referred (Company.referrerIds), and Firestore has no foreign keys
    // to notice — deleting one from the browser would leave those references
    // pointing at nothing, with no warning and no undo.
    match /contacts/{id} {
      allow read, create, update: if hasAccess();
      allow delete: if false;
    }

    // Sourcing candidates: companies our investors back that we do not track.
    // Derived data, rebuilt by discovery from the investor repository and the
    // companies collection, so it is fully writable — nothing here is a record
    // of anything a person authored.
    match /sourcing/{id} {
      allow read, write: if hasAccess();
    }

    // Append-only, and this time it actually is: nothing else matches these
    // documents, so create is the only write that any rule permits.
    match /audit/{entry} {
      allow read, create: if hasAccess();
      allow update, delete: if false;
    }
  }
}
