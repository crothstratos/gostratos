rules_version = '2';

// Stratos VP CRM — Firestore access policy
//
// Access requires a signed-in Google account with a verified
// @gostratos.vc email address that is not on the revoked list.
//
// To grant an outside collaborator access, add their address to the
// EXTRA list in allowed(). To revoke someone, add them to revoked().
// Redeploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function userEmail() {
      return request.auth.token.email.lower();
    }

    function signedIn() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    function revoked() {
      return userEmail() in [
        'dwhite@gostratos.vc',
        'cjrothai@gmail.com',
        'joe@highwayventures.com'
      ];
    }

    function allowed() {
      return userEmail().matches('^[^@]+@gostratos[.]vc$')
        || userEmail() in [
          // Individually approved outside collaborators go here, e.g.:
          // 'advisor@example.com',
          'placeholder@example.invalid'
        ];
    }

    function hasAccess() {
      return signedIn() && allowed() && !revoked();
    }

    // Audit records are append-only: anyone authorized can write one and
    // read the history, but nobody can edit or delete an entry. An audit
    // trail you can rewrite is not an audit trail.
    match /audit/{entry} {
      allow read, create: if hasAccess();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if hasAccess();
    }
  }
}
