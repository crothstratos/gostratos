# Copy this file to env.yaml and fill in the real values.
# env.yaml is gitignored — never commit it.
#
# Note: there is no FIREBASE_SERVICE_ACCOUNT here on purpose. On App Engine
# the server authenticates to Firestore using App Engine's own identity,
# so no private key file is needed.

env_variables:
  API_KEY: "YOUR_GEMINI_API_KEY"
