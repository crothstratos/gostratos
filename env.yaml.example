# Copy this file to env.yaml and fill in the real values.
# env.yaml is gitignored — never commit it.
#
# Note: there is no FIREBASE_SERVICE_ACCOUNT here on purpose. On App Engine
# the server authenticates to Firestore using App Engine's own identity,
# so no private key file is needed.

env_variables:
  API_KEY: "YOUR_GEMINI_API_KEY"

  # Optional. Overrides the Gemini model every AI endpoint uses. Omit to take
  # the default in server.ts, which tracks the current stable Flash release.
  # Changing this is a redeploy of env.yaml, not a code change.
  # GEMINI_MODEL: "gemini-3.8-flash"

  # Where nightly Firestore exports are written. Without it the export job
  # runs, writes nothing, and says so — see docs/BACKUPS.md for the one-time
  # bucket and IAM setup.
  # BACKUP_BUCKET: "stratos-crm-backups"

  # ---- Granola ----
  # API key: Granola desktop app -> Settings -> Connectors -> API keys.
  # Needs at least the "Personal notes" scope; add "Public notes" to also file
  # meetings captured by colleagues in the Team Space.
  GRANOLA_API_KEY: "grn_..."
  # Signing secret, shown once when the webhook endpoint is created.
  GRANOLA_WEBHOOK_SECRET: "whsec_..."
  # Domains that are us, not a company we are meeting. Comma separated.
  GRANOLA_INTERNAL_DOMAINS: "gostratos.vc,highwayventures.com"
